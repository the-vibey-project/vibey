# Optional shell environment for the checked-in Qwen/Ollama storm profile.
# Source this file only after reviewing it; it contains no credentials.

export OLLAMA_CONTEXT_LENGTH=32768
export OLLAMA_FLASH_ATTENTION=1
export OLLAMA_KV_CACHE_TYPE=q8_0
export OLLAMA_MAX_LOADED_MODELS=1
export OLLAMA_NUM_PARALLEL=1

export VIBEY_OLLAMA_URL=http://127.0.0.1:11434
# vibey's sovereign DESIGN/DECOMPOSE providers and gptossloop run this model;
# unset, they run gpt-oss:20b. It never reaches qwenloop (ADR-0062).
export VIBEY_OLLAMA_MODEL=qwen3:14b
export QWENLOOP_BASE_URL=http://127.0.0.1:11434/v1
# qwenloop's default since ADR-0062; kept explicit for the storm.
export QWENLOOP_MODEL=qwen3:14b
# For vibey's worker to run qwenloop beside gptossloop, switch it on:
# export VIBEY_FEATURE_QWENLOOP=1

# Keep API keys out of files and command history. If the endpoint requires one,
# set QWENLOOP_API_KEY in the shell or a secret manager instead.
# export QWENLOOP_API_KEY=...

# The storm command keeps lifecycle desktop alerts enabled and uses Ping on macOS:
# qwenloop run --storm --desktop-notifications
