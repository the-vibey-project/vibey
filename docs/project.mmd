%%{init: {"flowchart": {"htmlLabels": true}} }%%
%% Vibey — comprehensive architecture map. Status as of 2026-09-21.
%% Layers: source modules & onion boundaries, public interfaces, the six-phase
%% workflow, the ledger/handoff data flow, the isolation/security boundary, the
%% uv-workspace monorepo tenants, the governance canon, and the CI/release/docs
%% channels. Regenerate/edit by hand alongside any change to src/vibey/**,
%% src/vibey_runners/**, src/vibey_tools/**, .github/workflows/**, or deploy/**;
%% there is no generator. Mermaid rule: a node belongs to exactly one subgraph.
flowchart TB

    User(("Developer"))

    subgraph Interfaces["Public interfaces — cli/, tui/ are the outermost onion ring"]
        CLI["cli/main.py<br/>vibey new · answer · work · design · visual ·<br/>watch · recover · status · engines · cost ·<br/>ledger · deploy · doctor · operator · worker<br/>(+ cli/early_signals.py SIGTERM latch, ADR-0026)"]
        TUI["tui/dashboard.py<br/>live dashboard + ledger replay"]
        TomlCfg["vibey.toml<br/>domain/config.py schema + infrastructure/config_loader.py<br/>[features] local engines read by doctor/worker; [notifications] + [telemetry]<br/>copied into project config by vibey new<br/>(see docs/reference/configuration.md)"]
        K8sCRD["VibeyProject CRD (vibey.dev/v1alpha1)<br/>reconciled by infrastructure/operator/<br/>(pip install 'vibey[operator]')"]
        SkillsFlags["vibey new<br/>--skills-context-mode off / shadow / inject<br/>--skills-context-budget N<br/>recorded into project config at creation,<br/>not a vibey.toml table (ADR-0031)"]
    end

    User --> CLI
    User --> TUI
    CLI --> TUI
    TomlCfg -. "runtime tables copied at project creation" .-> CLI
    TomlCfg -. "[features] qwenloop only" .-> CLI

    subgraph Bootstrap["bootstrap.py — the sole composition root"]
        AppResources["AppResources<br/>wires every Protocol port in<br/>application/interfaces/ to one concrete adapter"]
    end
    CLI --> AppResources

    subgraph Domain["domain/ — pure stdlib, no I/O (import-linter enforced)"]
        DPhase["phase.py<br/>Phase enum + legal edges + routing decisions"]
        DLedger["ledger.py<br/>EventKind, append-only event shape"]
        DNoLoss["noloss.py<br/>no-loss handoff gate, rules R1-R10"]
        DHandoff["handoff.py<br/>HandoffBrief · HandoffEnvelope ·<br/>GateRule · GateResult"]
        DRotation["rotation.py<br/>select() — smooth weighted round robin"]
        DCapacity["capacity.py<br/>CreditsExhausted vs RateLimited"]
        DConfig["config.py<br/>VibeyConfig schema + validation"]
        DGuards["command_guard.py · scope_guard.py ·<br/>prompt_shield.py — security primitives"]
        DMore["and 17 more: job.py · engine.py · review.py ·<br/>plan.py · deployment.py · budget.py · briefing.py ·<br/>effort.py · circuit.py · media.py · verbosity.py ·<br/>worktree.py · errors.py · spec.py · projections.py ·<br/>provision.py · visual.py"]
    end

    subgraph Application["application/ — use cases behind Protocol ports"]
        ADesign["design_handler.py · design_acceptance.py ·<br/>design_synthesis_handler.py"]
        ABuild["build_decompose/implement/verify/integrate_handler.py<br/>(integrate serialized by an advisory lock, ADR-0029)"]
        AReview["review_collect/triage/demo_handler.py"]
        ADeploy["deploy_design/execute/review_handler.py"]
        AWorker["worker.py — WorkerLoop"]
        AEngineSel["engine_selector.py · engine_selection.py"]
        AHandoff["rotation_handoff.py · wind_down.py · brief_producer.py"]
        APorts["interfaces/ — 12 Protocol port modules: azure · build ·<br/>design · engines · gates · ledger · observability ·<br/>projects · queue · review · system · visual (re-exported by application/ports.py)"]
        AMore["and 25 more: azure_port.py · budget_source.py ·<br/>build_engine_run.py · build_kickoff.py · conformance.py ·<br/>deploy_acceptance_handler.py · deploy_design_bridge.py ·<br/>deploy_review_routing.py · design.py · design_research_handler.py ·<br/>design_spec.py · dto.py · engine_health_service.py ·<br/>handoff_orchestration.py · job_dispatcher.py ·<br/>operator_projection.py · ports.py · project_kickoff.py ·<br/>review_deployment_choice_handler.py · seed_prompt.py ·<br/>text_verdict_fallback.py · verdict_extraction.py ·<br/>visual_acceptance.py · visual_handler.py · visual_spec.py"]
    end

    subgraph Infrastructure["infrastructure/ — adapters, all I/O"]
        IDb[("PostgreSQL<br/>queue (FOR UPDATE SKIP LOCKED) + ledger + repositories")]
        IDbMods["db/ — 15 modules: job · ledger · project · handoff · human_gate ·<br/>engine_health · rotation_cursor repositories · build/design/review ledgers ·<br/>design_spec · visual_inventory repositories · notifier.py (LISTEN/NOTIFY) ·<br/>migrator.py · advisory_lock.py (integration lock, ADR-0029)"]
        IEngines["engines/ — LoopProcessAdapter × 5 (paid tier)<br/>claudeloop · codexloop · cursorloop · agyloop · opencode<br/>+ local tier, preferred first (ADR-0038): qwenloop · claudeloop-local<br/>(features.* / VIBEY_FEATURE_* via LocalEngineSettings) — added when on"]
        IDesignProviders["engines/ DESIGN + decompose providers<br/>QwenloopDesignProvider · QwenloopWorkPlanProducer (sovereign, the preference — ADR-0027;<br/>one OllamaChatClient calling the local Ollama chat API directly, not the qwenloop binary) ·<br/>ClaudeLoopDesignProvider · ClaudeLoop decompose ·<br/>Scripted Design / Decompose / Visual providers<br/>selected by vibey work / worker --provider scripted, claudeloop, qwenloop"]
        IEngineInternals["engines/ internals — argv.py · classify.py · tailer.py ·<br/>loop_events.py · plan_writer.py · design_json.py (shared decoders) · ollama_chat.py · descriptors.py"]
        IGit["git/worktree_manager.py · integration_branch.py · clean_env.py"]
        IAzure["azure/az_cli.py · iac.py · arm.py · adapter.py"]
        INotify["notify/service.py · notify/webhook.py<br/>HMAC-SHA256 signed webhooks (+ desktop.py · events.py)<br/>constructed by bootstrap; gate/phase/completion events"]
        IProvision["provision/agent_surface.py<br/>writes the generated block into CLAUDE.md · AGENTS.md ·<br/>CURSOR.md · GEMINI.md · QWEN.md in each worktree (ADR-0011)"]
        IRedact["ledger/redact.py — credential/token/secret redaction<br/>ledger/full_ledger_writer.py<br/>ledger/static_export.py — published shard + static JSON site (7.a)"]
        ILogging["logging.py — structlog Logger adapter (observability port)"]
        ISkillsContext["skills_context.py<br/>VibeySkillsContextCompiler (ADR-0031)<br/>runs python -m vibey_skills.cli"]
        IOtel["otel.py<br/>TelemetryTracer + TelemetryMetrics<br/>+ calculate_rotation_fairness()<br/>constructed by bootstrap; in-process runtime recorder"]
        IBuildGates["build/gate_runner.py · automated_review_runner.py<br/>subprocess runners: BUILD's gate commands (+ git diff)<br/>and Phase 3's automated ruff/bandit review"]
        IContainer["container/config.py · runtime.py<br/>OciContainerExecutor — hardened OCI runtime wrapper<br/>(dormant, not constructed by bootstrap.py)"]
        IDeployState["deploy/state_repository.py<br/>file-backed deploy spec/consent state, per project"]
        IOperatorHandlers["operator/handlers.py<br/>kopf handlers for the VibeyProject CRD<br/>(import bootstrap + application, never cli/) — ADR-0025"]
        IClusterPreflight["cluster_preflight.py<br/>in-cluster wiring checks behind vibey doctor --cluster"]
        IWriters["context_writer.py · review_artifact_writer.py<br/>filesystem writers: DESIGN context artifacts,<br/>Phase 3 REVIEW artifacts"]
    end

    CLI --> Application
    AppResources --> Domain
    AppResources --> Application
    AppResources --> Infrastructure
    Application --> Domain
    Infrastructure -.->|implements interfaces from| APorts
    %% application never imports infrastructure (.importlinter); bootstrap.py binds every port

    AWorker -.->|EngineAdapter port| IEngines
    AWorker -.->|"JobRepository / LedgerRepository ports"| IDb
    IDbMods --> IDb
    IEngineInternals --> IEngines
    AHandoff --> DNoLoss
    AHandoff --> DHandoff
    AHandoff --> DLedger
    AEngineSel --> DRotation
    IEngines --> DCapacity
    INotify -. "[notifications] copied by vibey new" .-> AppResources
    IOtel -. "[telemetry] copied by vibey new" .-> AppResources
    SkillsFlags -->|project config| AppResources
    AppResources --> ISkillsContext
    ISkillsContext -->|"mode not off: packet recorded to the ledger on every BUILD job<br/>that carries no handoff seed_prompt; inject mode also appends it to the prompt"| ABuild
    ABuild -.->|GateRunner port| IBuildGates
    AReview -.->|AutomatedReviewRunner port| IBuildGates
    ADesign -.->|DesignSpecRepository port| IWriters
    AReview -.->|ReviewArtifactWriter port| IWriters
    ADeploy -.->|DeploymentStateRepository port| IDeployState
    CLI -->|--provider| IDesignProviders
    IDesignProviders -.->|DesignProvider port| ADesign
    CLI --> IClusterPreflight
    CLI -->|"vibey operator (kopf)"| IOperatorHandlers
    K8sCRD -->|reconciled by| IOperatorHandlers
    IOperatorHandlers --> AppResources

    subgraph Workflow["The six-phase delivery workflow — domain/phase.py"]
        Intake(["INTAKE"]) --> PDesign["① DESIGN — interactive"]
        PDesign -->|visual opt-in| PVisual["VISUAL_DESIGN — interactive,<br/>media generation + confirmation"]
        PDesign -->|visual declined| PBuild["② BUILD — autonomous"]
        PVisual -->|every visual accepted/waived| PBuild
        PBuild <--> PReview["③ REVIEW — interactive<br/>(automated ruff/bandit collect, then user triage + demo)"]
        PBuild -.->|"at least 1 work item blocked on ambiguity"| PDesign
        PReview -.->|"finding needs clarification / strict loop-back (ADR-0010)"| PDesign
        PReview -->|deployment declined| DoneLocal(["DONE (local)"])
        PReview -->|deployment opt-in| PDeployDesign["④ DEPLOY_DESIGN — interactive"]
        DoneLocal -.->|later deployment opt-in| PDeployDesign
        PDeployDesign -->|"spec accepted + consent recorded"| PDeployExecute["⑤ DEPLOY_EXECUTE — autonomous"]
        PDeployDesign -.->|re-interview| PDeployDesign
        PDeployExecute -.->|retry| PDeployExecute
        PDeployExecute --> PDeployReview["⑥ DEPLOY_REVIEW — interactive"]
        PDeployReview --> DoneDeployed(["DONE (deployed)"])
        PDeployReview -.->|"application defect found (code_defect), back to ① DESIGN"| PDesign
        PDeployReview -.->|deployment details changed| PDeployDesign
        PDeployReview -.->|unambiguous deploy retry| PDeployExecute
        Abandoned(["ABANDONED"])
        PDesign & PVisual & PBuild & PReview & PDeployDesign & PDeployExecute & PDeployReview -.-> Abandoned
    end

    ADesign --> PDesign
    ABuild --> PBuild
    AReview --> PReview
    ADeploy --> PDeployDesign
    ADeploy --> PDeployExecute
    ADeploy --> PDeployReview

    subgraph DataFlow["Ledger & handoff data flow"]
        EngineRun["engine session process<br/>tails its own events.jsonl"] --> LedgerAppend["LedgerEventDraft appended<br/>to the Postgres ledger<br/>(TRUSTED provenance, append-only)"]
        LedgerAppend --> BudgetSrc["LedgerBudgetSource<br/>sums TurnCompleted + BudgetSpent<br/>per cycle / total"]
        LedgerAppend -->|CreditsExhausted raised| BriefProducer["brief_producer.py<br/>builds a HandoffBrief"]
        BriefProducer --> NoLossCheck{"no-loss gate:<br/>every open question, decision,<br/>and finding present in the brief?"}
        NoLossCheck -->|pass| FullLedgerWrite["full_ledger_writer.py writes the<br/>complete ledger into the receiving worktree"]
        NoLossCheck -->|fail| Escalate["retry, escalate to full-transcript mode,<br/>or open a human_gate — never a silent partial"]
        FullLedgerWrite --> NextEngine["next EngineAdapter resumes the job<br/>(seed_prompt reaches it byte-for-byte)"]
    end

    subgraph SecurityBoundary["Isolation & security boundary — ADR-0008, ADR-0012, ADR-0013, ADR-0014"]
        Worktree["ephemeral git worktree<br/>per job/phase, branched from base or integration"]
        CleanEnv["CleanGitEnvSubprocessExecutor (ACTIVE)<br/>git/clean_env.py — strips GIT_DIR · GIT_WORK_TREE · GIT_INDEX_FILE …<br/>used by worktree_manager · integration_branch · az_cli · agent_surface"]
        Redaction["ledger/redact.py (ACTIVE)<br/>credential/token/secret masks on ledger records"]
        ImageContracts["container image contracts (ACTIVE, ci.yml image job)<br/>non-root uid 10001 · no compiler/uv/pip · migrations present ·<br/>chart securityContext on worker + operator pods"]
        Container["OCI container (dormant):<br/>--read-only rootfs · --cap-drop=ALL ·<br/>no-new-privileges · --network=none by default ·<br/>tmpfs /tmp noexec,nosuid · memory/CPU caps<br/>IMPLEMENTED + TESTED, NOT constructed by bootstrap.py"]
        Guard["CommandSecurityPolicy (dormant):<br/>blocks destructive git/fs/db/system commands<br/>IMPLEMENTED + TESTED, NOT called by any subprocess call site"]
        ScopeGuard["MutationScope (dormant):<br/>blocks path traversal, symlink escape,<br/>out-of-scope-file edits<br/>IMPLEMENTED + TESTED, NOT called by build_implement_handler.py"]
        Shield["PromptShield (dormant):<br/>nonced delimiters + injection heuristics<br/>on all untrusted text input<br/>IMPLEMENTED + TESTED, NOT called by any design/build handler"]
    end

    Worktree -.->|dormant, not wired| Container
    IContainer -->|implements| Container
    Guard -.->|dormant, not wired| Worktree
    ScopeGuard -.->|dormant, not wired| Worktree
    Shield -.->|dormant, not wired| ADesign
    Shield -.->|dormant, not wired| ABuild
    ISkillsContext -.->|"third-party markdown from the vibey-skills<br/>marketplace, injected into BUILD prompts<br/>unshielded; not currently shielded"| Shield
    IEngines --> Worktree
    IGit --> CleanEnv
    IRedact --> Redaction
    IAzure -.->|"opt-in, mutates real resources<br/>only with --azure az"| PDeployExecute

    subgraph Monorepo["uv workspace monorepo — pyproject.toml [tool.uv.workspace] (ADR-0021, ADR-0022)"]
        Runners["src/vibey_runners/<br/>claude: claudeloop 0.8.0 · codex: codexloop 0.4.0 ·<br/>cursor: cursorloop 0.7.0 · agy: agyloop 0.5.0 ·<br/>opencode: opencodeloop 0.1.0 · qwen: qwenloop 0.2.0 ·<br/>common: vibey-runners-common 0.1.0<br/>(the *loop session runners; versioned in-tree, published only<br/>inside the vibey distribution — ADR-0037)"]
        ToolGh["src/vibey_tools/gh — vibey-gh 1.73.0<br/>provenance · PR automation · merge train · promote ·<br/>release · realign · github-release · release surfaces ·<br/>book · paper · corpus-index · forge-snapshot (ADR-0028)"]
        ToolSkills["src/vibey_tools/skills — vibey-skills<br/>Agent Skills marketplace + context compiler CLI"]
        ToolBootstrap["src/vibey_tools/bootstrap — vibey-bootstrap 4.2.3<br/>Azure App Configuration · Key Vault · App Insights bootstrap library"]
        LiveHarness["tests/live — two-mode live harness (ADR-0030)<br/>faked: ScriptedEngine, no subprocess ·<br/>paid: real engine binaries against real models"]
    end
    IEngines -->|spawns| Runners
    IDesignProviders -->|spawns claudeloop| Runners
    ISkillsContext -->|python -m vibey_skills.cli| ToolSkills
    LiveHarness -.-> IEngines

    subgraph Governance["Governance canon — src/vibey_tools/gh/docs/ (ADR-0020)"]
        Canon["doctrines.md (the sealed Twelve + sub-doctrines, e.g. 8.a sovereign-first) ·<br/>constitution.md · commandments.md · bill-of-rights.md ·<br/>sd-01-counterparties-trust-verification.md (carried verbatim in CLAUDE.md)"]
        CorpusIdx["src/vibey_tools/gh/corpus-index.json<br/>33 chunks + corpus_sha256<br/>checked by vibey-gh corpus-index --check"]
        Canon --> CorpusIdx
    end
    ToolGh --> CorpusIdx
    Canon -.->|"8.a: sovereign path preferred"| IDesignProviders

    subgraph Release["CI, release and docs channels — .github/workflows/ (ADR-0023, ADR-0028)"]
        PR(["pull request or push → develop / main"]) --> CIWF["CI (ci.yml)<br/>uv-lock · gates: ruff · format · mypy --strict · pytest+cov ·<br/>4× per-layer 100% branch gates · lint-imports · bandit · pip-audit ·<br/>PostgreSQL compatibility 14–18 · tools matrix, every tenant suite on<br/>Python 3.12/3.13/3.14 plus its static gates and strict docs builds ·<br/>reports, not required in .vibey-gh.toml · tools-lint ·<br/>image: amd64 + arm64, one Image contract step per Dockerfile claim, not pushed ·<br/>cluster-smoke: helm on minikube, KEDA + SIGTERM drain"]
        AnyPush(["git push: any branch · every PR"]) --> Provenance["Provenance workflow (provenance.yml)<br/>vibey-gh check --ci on every push and PR"]
        PR --> Provenance
        CIWF --> PRAuto["PR automation (pr-automation.yml)<br/>vibey-gh pr-automation evaluate · review · repair · mirror-fork"]
        Provenance --> PRAuto
        PRAuto --> MergeTrain["Merge train (merge-train.yml)<br/>vibey-gh merge-train: squash into develop,<br/>rebase into main"]
        MergeTrain --> Promote["Promote (promote-to-main.yml)<br/>vibey-gh promote: develop → main PR"]
        Bootstrap0(["automation-bootstrap.yml — manual, one-shot<br/>verified merge of an automation-repair PR"])
        SourcePush(["git push: develop or main"]) --> ReleaseWF["Release workflow (release.yml)<br/>vibey-gh owns versioning; release-please retired"]
        Promote --> SourcePush
        MergeTrain --> SourcePush
        ReleaseWF --> BuildDist["build wheel + sdist<br/>one distribution: vibey + every tenant package<br/>and every console script (ADR-0037)"]
        BuildDist -->|develop| TestPyPI["TestPyPI<br/>package renamed vibey-dev, dev-versioned<br/>(+ verify-testpypi)"]
        BuildDist -->|main| PyPI["PyPI<br/>package vibey, OIDC trusted publishing"]
        ReleaseWF -->|main only| Realign["realign job<br/>vibey-gh realign: develop := main"]
        ReleaseWF -.->|"workflow_run: completed, success, main only"| GhRelease["GitHub Release (github-release.yml)<br/>vibey-gh github-release: immutable tag + release"]
        ReleaseWF -.->|"workflow_run: completed, success"| ReleaseSurfaces["Release surfaces workflow<br/>(release-surfaces.yml)<br/>re-downloads the dist artifact by run id"]
        ReleaseSurfaces --> OCIPkg["GitHub Packages<br/>ghcr.io/.../python (oras: wheel + sdist)"]
        ReleaseSurfaces --> Pages["GitHub Pages — ProperDocs, one channel per branch<br/>the-vibey-project.github.io/vibey/ (channel chooser)<br/>…/main/ production · …/develop/ preview"]
        Pages --> Book["…/main/book.pdf · book.epub · book-print.html<br/>(vibey-gh book, KDP interior)"]
        Pages --> Paper["…/main/paper/ (docs/paper.md) · paper.pdf<br/>(vibey-gh paper → LaTeX, Tectonic)"]
        Pages -.->|"only if corpus-index.json exists at the repo root — it does not"| CorpusShip["…/channel/corpus-index.json"]
        DockerImg["deploy/docker/Dockerfile<br/>two-stage, no compiler/uv/pip/node/npm in the runtime layer,<br/>uid 10001, tini -g as PID 1 (ADR-0026),<br/>codex as a pinned, digest-verified static binary"] --> HelmChart["deploy/helm/vibey chart (ADR-0025)<br/>worker Deployment · in-cluster Postgres 17 (runtime supports 14+) ·<br/>VibeyProject CRD (installCRD: true) · kopf operator (off by default) ·<br/>KEDA ScaledObject (off by default, 0–4 replicas, scoped to the worker's project) ·<br/>Ollama for qwenloop / sovereign DESIGN (off by default)"]
        HelmChart --> K8sCluster[("Kubernetes cluster<br/>minikube verified in ci.yml cluster-smoke<br/>no cloud values presets ship yet")]
    end

    CIWF -->|tools matrix| ToolGh
    CIWF -->|tools matrix| ToolSkills
    CIWF -->|tools matrix| ToolBootstrap
    CIWF -->|"tools matrix: the six runner suites and every runner's static gates"| Runners
    CIWF -->|image + cluster-smoke| DockerImg
    Provenance -->|vibey-gh check --ci| ToolGh
    ReleaseSurfaces -->|"vibey-gh book · paper"| ToolGh
    Bootstrap0 -.-> MergeTrain
    DockerImg --> ImageContracts
