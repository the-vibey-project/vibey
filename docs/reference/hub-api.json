        "operationId": "metrics_api_metrics_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "description": "The request proves no principal."
          },
          "403": {
            "description": "The principal's scopes do not permit this."
          },
          "411": {
            "description": "A body was sent without a Content-Length."
          },
          "413": {
            "description": "The body is larger than the hub reads."
          },
          "421": {
            "description": "The Host header is not one this hub answers."
          },
          "429": {
            "description": "Too many requests."
          }
        },
        "security": [
          {
