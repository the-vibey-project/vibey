{
  "components": {
    "schemas": {
      "ClaimBody": {
        "additionalProperties": false,
        "description": "The body of `POST /api/v1/pairing/claim` (a device, before it holds a key).",
        "properties": {
          "code": {
            "description": "The code the host shows.",
            "maxLength": 6,
            "minLength": 6,
            "title": "Code",
            "type": "string"
          },
          "name": {
            "description": "What the device calls itself.",
            "maxLength": 64,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "code",
          "name"
        ],
        "title": "ClaimBody",
        "type": "object"
      },
      "GateAnswerBody": {
        "additionalProperties": false,
        "description": "The body of `POST /api/v1/gates/{gate_id}/answer`.",
        "properties": {
          "answer": {
            "additionalProperties": true,
            "description": "The answer, as `vibey answer --raw` takes it, e.g. {\"choice\": \"yes\"}.",
            "title": "Answer",
            "type": "object"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Names this request so a retry of the same answer is a no-op.",
            "title": "Request Id"
          }
        },
        "required": [
          "answer"
        ],
        "title": "GateAnswerBody",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HubScope": {
        "description": "One kind of permission a paired device can hold. Stored by value.",
        "enum": [
          "view",
          "answer",
          "spend",
          "run",
          "bump"
        ],
        "title": "HubScope",
        "type": "string"
      },
      "OfferBody": {
        "additionalProperties": false,
        "description": "The body of `POST /api/v1/pairing/offers` (the host only).",
        "properties": {
          "scopes": {
            "description": "What a device claiming the code may do; never empty.",
            "items": {
              "$ref": "#/components/schemas/HubScope"
            },
            "minItems": 1,
            "title": "Scopes",
            "type": "array"
          }
        },
        "required": [
          "scopes"
        ],
        "title": "OfferBody",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "description": "The host's token, or a device's key.",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "summary": "The one HTTP surface every Krypton client reaches (ADR-0067).",
    "title": "vibey hub",
    "version": "1"
  },
  "openapi": "3.1.0",
