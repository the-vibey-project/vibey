# Normalize line endings for everything text-like; let git decide binary-ness.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Keep generated docs and vendored/legacy reference material out of GitHub's
# language statistics and out of PR diffs by default.
docs/reference/* linguist-generated=true
legacy/* linguist-vendored=true

# vibey-gh: append-only files merge instead of conflicting
CHANGELOG.md merge=union
