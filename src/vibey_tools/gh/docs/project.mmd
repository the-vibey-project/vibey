  subgraph Core["Dependency-free vibey-gh core"]
    Config[Configuration and policy]
    Install[Installer and rendered templates]
    Fingerprints[Conventional Commits and Provenance]
    Debugging["Debugging (opt-in, tamper-evident branch tracing)"]
    Documentation[Documentation contract]
    PRAutomation[PR Automation]
    IssueAutomation[Issue Automation]
    Conversation["Conversation (comment-driven answer and bounded change, vibey_gh.conversation)"]
    GithubState["Durable marker-comment state (vibey_gh.github_state)"]
    MergeTrain[Merge train]
    Promotion[Promotion]
    Versioning[Versioning]
    PublishRelease["Release (hand-authored PyPI/TestPyPI publish)"]
    Release[GitHub releases]
    CapabilitySurfaces["Capability surfaces (vibey_gh.surfaces)"]
    ReleaseSurfaces[Release surfaces publishing]
    Realign[Realign released branches]
    Reconcile["Stranded-branch reconciliation (vibey_gh.reconcile)"]
    Rulesets["Branch ruleset reconciliation (vibey_gh.rulesets)"]
    Doctor["Offline adoption preflight (vibey_gh.doctor)"]
    LocalFallback["Local-model review (vibey_gh.local_review): local-review with a sovereign or fallback role, and local-triage"]
    ReviewContract["Review contract (vibey_gh.review_contract): diff-groundable vs wider-context halves, the wider half's own report fields, and both review JSON Schemas"]
