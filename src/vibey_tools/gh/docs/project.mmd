    Book["Docs-to-book export (vibey_gh.book): EPUB 3.0 + KDP print-ready HTML"]
  end

  subgraph PluginMarketplace["Claude plugin marketplace (.claude-plugin/marketplace.json)"]
    ClaudeSettings["Marketplace registration (.claude/settings.json)"]
    DevPlugin["vibey-gh-development plugin (architecture-reviewer agent, verify command, testing/architecture skills)"]
    DocsPlugin["vibey-gh-documentation plugin (documentation-auditor agent, refresh-docs command, foss-documentation/llm-discovery skills)"]
    SecurityPlugin["vibey-gh-release-security plugin (release-auditor agent, release-safety/threat-model skills, no commands)"]
    PRPlugin["vibey-gh-pr-automation plugin (pr-reviewer agent, evaluate-pr command, conflict-resolution/pr-repair skills)"]
  end

  subgraph Security["Security Boundary"]
    Trusted[Trusted base-branch automation]
    Untrusted[Untrusted PR source and model output]
    Sandbox[Constrained read/edit tools]
    EphemeralGit[Credential-free ephemeral Git context]
    CredentialHelper[Token-free action credential helper]
    SafeProgress[Sanitized Claude progress and restricted artifacts]
    ProgressGuard[Supported-event progress guard]
    RawOutput[Manual private-only raw Claude diagnostics]
    Diagnostics[Bounded exact-head failed-check evidence]
    Guard[Exact SHA, branch, lease, and policy guards]
    Bootstrap[Admin-authorized automation bootstrap]
    ReviewIncomplete["Review incomplete: no verdict, operator action required"]
    FallbackDeclined["Local verdict declined: a blocking finding to verify (never auto-repaired), or a diff too large to judge"]
    LocalReviewFallback["Sovereign diff review, review-sovereign (runs FIRST on a fresh heartbeat; self-hosted runner, no push credential, Ollama, trusted_only excludes forks)"]
    LocalTriageFallback["Local-model triage fallback (same self-hosted runner boundary, issues: write only, one deduplicated analysis comment, never code)"]
    SupersededReport["Superseded-release report (read-only index query; PyPI has no yank API, a human clicks)"]
    UntrustedIssue[Untrusted contributor issue text]
    Briefing[Bounded untrusted issue briefing]
    IssueTrust["Issue eligibility policy (author trust, labels, budget)"]
    Fork[Untrusted fork PR head]
    MirrorFork["Repository-owned replacement PR (mirror-fork)"]
    UntrustedComment[Untrusted contributor comment text]
    ConversationBriefing[Bounded untrusted conversation briefing]
    ConversationTrust["Conversation eligibility policy (mention, trust, interaction budget, self-reply loop guard)"]
  end

  subgraph Delivery["Event-driven delivery"]
    BranchIntake[Branch intake]
    IssueSolution[Guarded issue solution branch and linked PR]
    CI[CI, tests, lint, build]
    CodeQL[CodeQL security analysis]
    APIDrift[API drift and five-surface parity]
    Provenance[Provenance workflow]
    Docs[Documentation and Mermaid review]
    Conventional[Conventional Commits self-heal]
    Review[Claude exact-head review]
    Repair[Bounded self-healing repair]
    Develop[develop]
    Main[main]
    TestPyPI[TestPyPI]
    PyPI[PyPI]
    Packages[GitHub Packages]
    Pages[GitHub Pages]
    RepositoryProfile[Repository profile]
    ReleaseRepair[Release repair]
    Conflict[Guarded same-repository conflict resolution]
    BranchSync[Branch sync]
    SelfHeal[Self-heal spent repair budgets]
    ConversationReply[Guarded conversation reply and optional bounded commit]
  end

