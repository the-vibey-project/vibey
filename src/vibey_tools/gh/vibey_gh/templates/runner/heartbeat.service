# Rendered by `vibey-gh heartbeat install` from [runners]; do not edit, re-install instead.
#
# One sovereign heartbeat, started by the timer beside this unit. `sovereign --beat` pushes
# nothing unless the runner is registered and online and the model endpoint answers, and
# records what it did in the record file named below, which `vibey-gh heartbeat status`
# reads. It pushes from the repository the timer owns (vibey ADR-0060), through that
# clone's own pre-push gate; nothing here skips it. No network-online.target: a user
# manager has none, and a beat with no network withholds itself and says so.
[Unit]
Description=vibey sovereign heartbeat for __REPOSITORY__

[Service]
Type=oneshot
WorkingDirectory=__CLONE__
Environment=__PATH_ASSIGNMENT__
Environment=PYTHONSAFEPATH=1
ExecStart=__EXEC_START__
StandardOutput=append:__LOG__
StandardError=append:__LOG__
