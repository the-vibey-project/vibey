<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Rendered by `vibey-gh heartbeat install` (and `vibey-gh runner install`) from the
  repository's [runners] and [pr_automation.fallback] tables. Do not edit: edit the tables and
  re-install; `vibey-gh heartbeat status` reports drift.

  Publishes the sovereign heartbeat on a timer, and only an honest one: a beat pushes
  nothing unless the runner is registered and online and the model endpoint answers, so a
  machine that cannot serve the lane lets the heartbeat go stale on its own. Each run
  records what it did in the record file below, which `heartbeat status` reads.

  The push goes through the repository's own pre-push gate, which recognises a push that
  carries no code by its own rule. Nothing here skips it.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>__LABEL__</string>

  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>-m</string>
    <string>vibey_gh.cli</string>
    <string>sovereign</string>
    <string>--beat</string>
    <string>--record</string>
    <string>__RECORD__</string>
  </array>

  <!-- The checkout the heartbeat is pushed from: its remote and its pre-push gate. -->
  <key>WorkingDirectory</key>
  <string>__CHECKOUT__</string>

  <!--
    launchd starts jobs with a near-empty PATH; git and gh must be reachable from it.
    PYTHONSAFEPATH keeps the checkout itself off sys.path, so the interpreter runs the
    vibey_gh it was installed with and never a package the working tree happens to hold.
  -->
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__PATH__</string>
    <key>PYTHONSAFEPATH</key>
    <string>1</string>
  </dict>

  <!-- At most half the age at which the gate stops trusting a heartbeat. -->
  <key>StartInterval</key>
  <integer>__INTERVAL_SECONDS__</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__LOG__</string>
  <key>StandardErrorPath</key>
  <string>__LOG__</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
