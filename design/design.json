{
  "$description": "Where the design system's web outputs land. Every documentation site and every vibey-gh managed copy reads the same generated bytes; add a site here, never a hand copy.",
  "tokens": "design/tokens",
  "contrast": "design/contrast.json",
  "stylesheet": {
    "source": "design/web/vibey.css",
    "targets": [
      "docs/stylesheets/vibey.css",
      "src/vibey_tools/gh/docs/stylesheets/vibey.css",
      "src/vibey_tools/bootstrap/docs/stylesheets/vibey.css",
      "src/vibey_runners/agy/docs/stylesheets/vibey.css",
      "src/vibey_runners/claude/docs/stylesheets/vibey.css",
      "src/vibey_runners/codex/docs/stylesheets/vibey.css",
      "src/vibey_runners/cursor/docs/stylesheets/vibey.css",
      "src/vibey_runners/qwen/docs/stylesheets/vibey.css",
      ".github/vibey-gh/release/vibey.css",
      "src/vibey_tools/gh/.github/vibey-gh/release/vibey.css"
    ]
  },
  "script": {
    "source": "design/web/channel.js",
    "targets": [
      "docs/javascripts/channel.js",
      "src/vibey_tools/gh/docs/javascripts/channel.js",
      "src/vibey_tools/bootstrap/docs/javascripts/channel.js",
      "src/vibey_runners/agy/docs/javascripts/channel.js",
      "src/vibey_runners/claude/docs/javascripts/channel.js",
      "src/vibey_runners/codex/docs/javascripts/channel.js",
      "src/vibey_runners/cursor/docs/javascripts/channel.js",
      "src/vibey_runners/qwen/docs/javascripts/channel.js",
      ".github/vibey-gh/release/channel.js",
      "src/vibey_tools/gh/.github/vibey-gh/release/channel.js"
    ]
  },
  "identity": "design/identity",
  "rasters": "design/dist/icons/manifest.json"
}
