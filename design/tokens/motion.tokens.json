{
  "$description": "Motion: purposeful, quick, and never required. Every duration has a reduced-motion twin under motion.reduced, honoured whenever the platform asks for less motion.",
  "motion": {
    "duration": {
      "$type": "duration",
      "instant": {
        "$value": {
          "value": 80,
          "unit": "ms"
        }
      },
      "fast": {
        "$value": {
          "value": 140,
          "unit": "ms"
        }
      },
      "base": {
        "$value": {
          "value": 220,
          "unit": "ms"
        }
      },
      "slow": {
        "$value": {
          "value": 360,
          "unit": "ms"
        }
      },
      "deliberate": {
        "$value": {
          "value": 560,
          "unit": "ms"
        }
      },
      "ambient": {
        "$value": {
          "value": 2400,
          "unit": "ms"
        }
      }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": {
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Most movement: settles firmly."
      },
      "enter": {
        "$value": [
          0,
          0,
          0,
          1
        ],
        "$description": "Things arriving decelerate."
      },
      "exit": {
        "$value": [
          0.3,
          0,
          1,
          1
        ],
        "$description": "Things leaving accelerate away."
      },
      "emphasized": {
        "$value": [
          0.2,
          0,
          0,
          1.25
        ],
        "$description": "A small overshoot for moments of delight (a gate cleared, a run finished)."
      },
      "linear": {
        "$value": [
          0,
          0,
          1,
          1
        ]
      }
    },
    "reduced": {
      "$description": "Reduced motion: movement becomes a short crossfade or nothing.",
      "duration": {
        "$type": "duration",
        "instant": {
          "$value": {
            "value": 0,
            "unit": "ms"
          }
        },
        "fast": {
          "$value": {
            "value": 0,
            "unit": "ms"
          }
        },
        "base": {
          "$value": {
            "value": 80,
            "unit": "ms"
          }
        },
        "slow": {
          "$value": {
            "value": 80,
            "unit": "ms"
          }
        },
        "deliberate": {
          "$value": {
            "value": 120,
            "unit": "ms"
          }
        },
        "ambient": {
          "$value": {
            "value": 0,
            "unit": "ms"
          }
        }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        },
        "enter": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        },
        "exit": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        },
        "emphasized": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        },
        "linear": {
          "$value": [
            0,
            0,
            1,
            1
          ]
        }
      }
    },
    "transition": {
      "$type": "transition",
      "hover": {
        "$value": {
          "duration": "{motion.duration.fast}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.standard}"
        }
      },
      "enter": {
        "$value": {
          "duration": "{motion.duration.base}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.enter}"
        }
      },
      "exit": {
        "$value": {
          "duration": "{motion.duration.fast}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.exit}"
        }
      },
      "celebrate": {
        "$value": {
          "duration": "{motion.duration.deliberate}",
          "delay": {
            "value": 0,
            "unit": "ms"
          },
          "timingFunction": "{motion.easing.emphasized}"
        }
      }
    }
  }
}
